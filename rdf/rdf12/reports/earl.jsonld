              },
              {
                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#horst-01-subClassOf-intensional",
                "@type": [
                  "mf:NegativeEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "horst-01-subClassOf-intensional",
                "rdfs:comment": "\n    rdfs:subClassOf has intensional semantics, not extensional.\n  ",
                "http://www.w3.org/ns/rdftest#approval": {
                  "@id": "http://www.w3.org/ns/rdftest#Approved"
                },
                "mf:entailmentRegime": "RDFS",
