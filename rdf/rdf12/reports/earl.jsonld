                "testResult": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/datatypes/test008b.nt"
              },
              {
                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#datatypes-test009",
                "@type": [
                  "mf:NegativeEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "datatypes-test009",
                "rdfs:comment": "\n    From decisions listed in\n    http://lists.w3.org/Archives/Public/w3c-rdfcore-wg/2002Oct/0098.html\n  ",
                "http://www.w3.org/ns/rdftest#approval": {
