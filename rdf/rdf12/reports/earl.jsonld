                  "@list": []
                },
                "testAction": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/horst-01/test001.ttl",
                "testResult": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/horst-01/test002.ttl"
              },
              {
                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#horst-01-subPropertyOf-intensional",
                "@type": [
                  "mf:NegativeEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "horst-01-subPropertyOf-intensional",
                "rdfs:comment": "\n    rdfs:subPropertyOf has intensional semantics, not extensional.\n  ",
                "http://www.w3.org/ns/rdftest#approval": {
                  "@id": "http://www.w3.org/ns/rdftest#Approved"
                },
                "mf:entailmentRegime": "RDFS",
                "mf:recognizedDatatypes": {
                  "@list": [
                    {
                      "@id": "http://www.w3.org/2001/XMLSchema#integer"
                    },
                    {
                      "@id": "http://www.w3.org/2001/XMLSchema#string"
                    }
                  ]
                },
                "mf:unrecognizedDatatypes": {
                  "@list": []
                },
                "testAction": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/horst-01/test003.ttl",
                "testResult": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/horst-01/test004.ttl"
              },
              {
                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#rdf-charmod-uris-test003",
                "@type": [
                  "mf:NegativeEntailmentTest",
