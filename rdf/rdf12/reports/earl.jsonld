      "mf:assumedTestBase": {
        "@id": "https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-semantics/"
      },
      "dc:issued": {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2023-07-20"
      },
      "dc:modified": {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2023-07-20"
      },
      "dc:licence": {
        "@id": "https://www.w3.org/Consortium/Legal/2008/03-bsd-license"
      },
      "dc:creator": {
        "@id": "_:b2",
        "foaf:homepage": "https://w3c.github.io/rdf-star-wg/",
        "foaf:name": "W3C RDF & SPARQL Working Group"
      },
      "rdfs:comment": "\n    These test suites are a product of the [W3C RDF & SPARQL Working Group](https://www.w3.org/groups/wg/rdf-star/) as well as the\n    RDF-Star Interest Group within the W3C RDF-DEV Community Group,\n    and has been maintained by the\n    [RDF Test Curation Community Group](https://www.w3.org/community/rdf-tests/)\n    at [https://github.com/w3c/rdf-tests/tree/main/rdf/rdf11](https://github.com/w3c/rdf-tests/tree/main/rdf/rdf11/).\n\n    Conformance with RDF 1.2 specifications can be determined via successfully running the\n    tests for relevant specifications\n    along with the relevant RDF 1.1 tests.\n  ",
      "rdfs:seeAlso": {
        "@id": "https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-semantics/README"
      },
      "mf:include": {
        "@list": [
          {
            "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl",
            "@type": [
              "mf:Manifest",
              "Report"
            ],
            "rdfs:label": "RDF Schema and Semantics tests",
            "entries": [
              {
                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#datatypes-intensional-xsd-integer-decimal-compatible",
                "@type": [
                  "mf:NegativeEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "datatypes-intensional-xsd-integer-decimal-compatible",
                "rdfs:comment": "\n    The claim that xsd:integer is a subClassOF xsd:decimal is not\n    incompatible with using the intensional semantics for\n    datatypes.\n  ",
                "http://www.w3.org/ns/rdftest#approval": {
                  "@id": "http://www.w3.org/ns/rdftest#Approved"
                },
                "mf:entailmentRegime": "RDFS",
                "mf:recognizedDatatypes": {
                  "@list": [
                    {
                      "@id": "http://www.w3.org/2001/XMLSchema#decimal"
                    },
                    {
                      "@id": "http://www.w3.org/2001/XMLSchema#integer"
                    }
                  ]
                },
                "mf:unrecognizedDatatypes": {
                  "@list": []
                },
                "testAction": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/datatypes-intensional/test001.nt",
                "mf:result": {
                  "@type": "http://www.w3.org/2001/XMLSchema#boolean",
                  "@value": "false"
                }
              },
              {
                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#datatypes-non-well-formed-literal-1",
                "@type": [
                  "mf:NegativeEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "datatypes-non-well-formed-literal-1",
                "rdfs:comment": [
                  "\n    Without datatype knowledge, a 'badly-formed' datatyped literal\n    cannot be detected.\n  ",
                  "\n    Used to be a postitive test to itself.\n  "
                ],
                "http://www.w3.org/ns/rdftest#approval": {
                  "@id": "http://www.w3.org/ns/rdftest#Approved"
                },
                "mf:entailmentRegime": "RDFS",
                "mf:recognizedDatatypes": {
                  "@list": []
                },
                "mf:unrecognizedDatatypes": {
                  "@list": [
                    {
                      "@id": "http://www.w3.org/2001/XMLSchema#integer"
                    }
                  ]
                },
                "testAction": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/datatypes/test002.nt",
                "mf:result": {
                  "@type": "http://www.w3.org/2001/XMLSchema#boolean",
                  "@value": "false"
                }
              },
              {
                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#datatypes-non-well-formed-literal-2",
                "@type": [
                  "mf:PositiveEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "datatypes-non-well-formed-literal-2",
                "rdfs:comment": [
                  "\n    With appropriate datatype knowledge, a 'badly-formed'\n    datatyped literal can be detected.\n  ",
                  "\n    Ill-formed datatyped literals now are inconsistent.\n    Used to be negative entailment to <datatypes/test002b.nt>\n  "
                ],
                "http://www.w3.org/ns/rdftest#approval": {
                  "@id": "http://www.w3.org/ns/rdftest#Approved"
                },
                "mf:entailmentRegime": "RDFS",
                "mf:recognizedDatatypes": {
                  "@list": [
                    {
                      "@id": "http://www.w3.org/2001/XMLSchema#integer"
                    }
                  ]
                },
                "mf:unrecognizedDatatypes": {
                  "@list": []
                },
                "testAction": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/datatypes/test002.nt",
                "mf:result": {
                  "@type": "http://www.w3.org/2001/XMLSchema#boolean",
                  "@value": "false"
                }
              },
              {
                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#datatypes-semantic-equivalence-within-type-1",
                "@type": [
                  "mf:PositiveEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "datatypes-semantic-equivalence-within-type-1",
                "rdfs:comment": "\n    Demonstrating the semantic equivalence of two lexical forms of\n    the same datatyped value.\n  ",
                "http://www.w3.org/ns/rdftest#approval": {
                  "@id": "http://www.w3.org/ns/rdftest#Approved"
                },
                "mf:entailmentRegime": "RDF",
                "mf:recognizedDatatypes": {
                  "@list": [
                    {
                      "@id": "http://www.w3.org/2001/XMLSchema#integer"
                    }
                  ]
                },
                "mf:unrecognizedDatatypes": {
                  "@list": []
                },
                "testAction": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/datatypes/test003a.nt",
                "testResult": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/datatypes/test003b.nt"
              },
              {
                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#datatypes-semantic-equivalence-within-type-2",
                "@type": [
                  "mf:PositiveEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "datatypes-semantic-equivalence-within-type-2",
                "rdfs:comment": "\n    As semantic-equivalence-within-type-1; the entailment works\n    both ways.\n  ",
                "http://www.w3.org/ns/rdftest#approval": {
                  "@id": "http://www.w3.org/ns/rdftest#Approved"
                },
                "mf:entailmentRegime": "RDF",
                "mf:recognizedDatatypes": {
                  "@list": [
                    {
                      "@id": "http://www.w3.org/2001/XMLSchema#integer"
                    }
                  ]
                },
                "mf:unrecognizedDatatypes": {
                  "@list": []
                },
                "testAction": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/datatypes/test003b.nt",
                "testResult": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/datatypes/test003a.nt"
              },
              {
                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#datatypes-semantic-equivalence-between-datatypes",
                "@type": [
                  "mf:PositiveEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "datatypes-semantic-equivalence-between-datatypes",
                "rdfs:comment": "\n    Members of different datatypes may be semantically equivalent.\n  ",
                "http://www.w3.org/ns/rdftest#approval": {
                  "@id": "http://www.w3.org/ns/rdftest#Approved"
                },
                "mf:entailmentRegime": "RDF",
                "mf:recognizedDatatypes": {
                  "@list": [
                    {
                      "@id": "http://www.w3.org/2001/XMLSchema#decimal"
                    },
                    {
                      "@id": "http://www.w3.org/2001/XMLSchema#integer"
                    }
                  ]
                },
                "mf:unrecognizedDatatypes": {
                  "@list": []
                },
                "testAction": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/datatypes/test005a.nt",
                "testResult": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/datatypes/test005b.nt"
              },
              {
                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#datatypes-range-clash",
                "@type": [
                  "mf:PositiveEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "datatypes-range-clash",
                "rdfs:comment": "\n    Where sufficient DT knowledge is available, a range clash may\n    be detected; the document then contains a contradiction.\n  ",
                "http://www.w3.org/ns/rdftest#approval": {
                  "@id": "http://www.w3.org/ns/rdftest#Approved"
                },
                "mf:entailmentRegime": "RDFS",
                "mf:recognizedDatatypes": {
                  "@list": [
                    {
                      "@id": "http://www.w3.org/2001/XMLSchema#integer"
                    },
                    {
                      "@id": "http://www.w3.org/2001/XMLSchema#string"
                    }
                  ]
                },
                "mf:unrecognizedDatatypes": {
                  "@list": []
                },
                "testAction": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/datatypes/test006.nt",
                "mf:result": {
                  "@type": "http://www.w3.org/2001/XMLSchema#boolean",
                  "@value": "false"
                }
              },
              {
                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#datatypes-test008",
                "@type": [
                  "mf:PositiveEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "datatypes-test008",
                "rdfs:comment": "\n    From decisions listed in\n    http://lists.w3.org/Archives/Public/w3c-rdfcore-wg/2002Oct/0098.html\n  ",
                "http://www.w3.org/ns/rdftest#approval": {
                  "@id": "http://www.w3.org/ns/rdftest#Approved"
                },
                "mf:entailmentRegime": "simple",
                "mf:recognizedDatatypes": {
