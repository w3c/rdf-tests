          "mf:result": {
            "@type": "http://www.w3.org/2001/XMLSchema#boolean",
            "@value": "false"
          },
          "assertions": [
            {
              "@id": "_:b724",
              "@type": "Assertion",
              "subject": "https://www.npmjs.com/package/rdf-parse/",
