                  "mf:PositiveEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "rdfs-subPropertyOf-semantics-test001",
                "rdfs:comment": "\n    The inheritance semantics of the subPropertyOf relationship\n    needs to be clarified. => subProperties inherit conjunctively\n    the domain and range of their superproperties\n  ",
                "http://www.w3.org/ns/rdftest#approval": {
                  "@id": "http://www.w3.org/ns/rdftest#Approved"
                },
