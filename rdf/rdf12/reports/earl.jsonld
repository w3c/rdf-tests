                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#rdfs-domain-and-range-intensionality-range",
                "@type": [
                  "mf:NegativeEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "rdfs-domain-and-range-intensionality-range",
                "rdfs:comment": "\n    RDF Semantics defines rdfs:range to have an intensional\n    reading. However, semantic extensions may give an extensional\n    reading to range. The premise/conclusion pair is a\n    non-entailment for RDFS reasoning, but may hold in semantic\n    extensions.\n  ",
                "http://www.w3.org/ns/rdftest#approval": {
                  "@id": "http://www.w3.org/ns/rdftest#Approved"
                },
                "mf:entailmentRegime": "RDFS",
