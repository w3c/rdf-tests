              {
                "@id": "https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-mt/manifest.ttl#datatypes-plain-literal-and-xsd-string",
                "@type": [
                  "mf:PositiveEntailmentTest",
                  "TestCriterion",
                  "TestCase"
                ],
                "title": "datatypes-plain-literal-and-xsd-string",
                "rdfs:comment": "\n    A plain literal denotes the same thing as its corresponding\n    xsd:string, where one exists.\n  ",
                "http://www.w3.org/ns/rdftest#approval": {
                  "@id": "http://www.w3.org/ns/rdftest#Approved"
                },
                "mf:entailmentRegime": "RDFS",
