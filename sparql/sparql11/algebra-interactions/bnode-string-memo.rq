PREFIX ex: <http://example.org/>
SELECT ?x ?first ?again ?fresh WHERE { VALUES ?x { "a" "b" } BIND(BNODE(?x) AS ?first) BIND(BNODE(?x) AS ?again) BIND(BNODE() AS ?fresh) }
