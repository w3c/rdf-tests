<?xml version="1.0" encoding="utf-8"?>
<sparql xmlns="http://www.w3.org/2005/sparql-results#">
<head>
  <variable name="s"/>
  <variable name="flag"/>
</head>
<results>
  <result>
    <binding name="s"><uri>http://example.org/in-error</uri></binding>
  </result>
  <result>
    <binding name="s"><uri>http://example.org/in-match</uri></binding>
    <binding name="flag"><literal datatype="http://www.w3.org/2001/XMLSchema#boolean">true</literal></binding>
  </result>
</results>
</sparql>
