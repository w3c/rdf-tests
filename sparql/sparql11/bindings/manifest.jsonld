{
  "@context": {
    "@base": "https://w3c.github.io/rdf-tests/sparql/sparql11/bindings/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "mf": "http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#",
    "mq": "http://www.w3.org/2001/sw/DataAccess/tests/test-query#",
    "rdft": "http://www.w3.org/ns/rdftest#",
    "dawgt": "http://www.w3.org/2001/sw/DataAccess/tests/test-dawg#",
    "ut": "http://www.w3.org/2009/sparql/tests/test-update#",
    "action": {
      "@id": "mf:action",
      "@type": "@id"
    },
    "comment": "rdfs:comment",
    "entries": {
      "@id": "mf:entries",
      "@container": "@list",
      "@type": "@id"
    },
    "include": {
      "@id": "mf:include",
      "@container": "@list",
      "@type": "@id"
    },
    "label": "rdfs:label",
    "name": "mf:name",
    "result": {
      "@id": "mf:result",
      "@type": "@id"
    },
    "entailmentRegime": {
      "@id": "mf:entailmentRegime"
    },
    "recognizedDatatypes": {
      "@id": "mf:recognizedDatatypes",
      "@type": "@id",
      "@container": "@list"
    },
    "unrecognizedDatatypes": {
      "@id": "mf:unrecognizedDatatypes",
      "@type": "@id",
      "@container": "@list"
    },
    "approval": {
      "@id": "dawgt:approval",
      "@type": "@id"
    },
    "approvedBy": {
      "@id": "dawgt:approvedBy",
      "@type": "@id"
    },
    "data": {
      "@id": "mq:data",
      "@type": "@id"
    },
    "feature": {
      "@id": "mf:feature",
      "@type": "@vocab"
    },
    "graphData": {
      "@id": "mq:graphData",
      "@type": "@id",
      "@container": "@set"
    },
    "notable": {
      "@id": "mf:notable",
      "@type": "@vocab"
    },
    "query": {
      "@id": "mq:query",
      "@type": "@id"
    },
    "queryForm": {
      "@id": "mq:queryForm",
      "@type": "@vocab"
    },
    "requires": {
      "@id": "mf:requires",
      "@type": "@vocab",
      "@container": "@set"
    },
    "ut:data": {
      "@id": "ut:data",
      "@type": "@id"
    },
    "ut:graphData": {
      "@id": "ut:graphData",
      "@container": "@set"
    },
    "ut:graph": {
      "@id": "ut:graph",
      "@type": "@id"
    },
    "ut:request": {
      "@id": "ut:request",
      "@type": "@id"
    }
  },
  "@id": "./",
  "@type": "mf:Manifest",
  "mf:specVersion": {
    "@id": "http://www.w3.org/ns/sparql#version-1.1"
  },
  "comment": "Bindings",
  "entries": [
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values1",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with subj-var, 1 row",
      "approval": "dawgt:Approved",
      "approvedBy": "http://www.w3.org/2009/sparql/meeting/2012-08-07#resolution_2",
      "action": {
        "query": "values01.rq",
        "data": "data01.ttl"
      },
      "result": "values01.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values2",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with obj-var, 1 row",
      "approval": "dawgt:Approved",
      "approvedBy": "http://www.w3.org/2009/sparql/meeting/2012-08-07#resolution_2",
      "action": {
        "query": "values02.rq",
        "data": "data02.ttl"
      },
      "result": "values02.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values3",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with 2 obj-vars, 1 row",
      "approval": "dawgt:Approved",
      "approvedBy": "http://www.w3.org/2009/sparql/meeting/2012-08-07#resolution_2",
      "action": {
        "query": "values03.rq",
        "data": "data03.ttl"
      },
      "result": "values03.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values4",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with 2 obj-vars, 1 row with UNDEF",
      "approval": "dawgt:Approved",
      "approvedBy": "http://www.w3.org/2009/sparql/meeting/2012-08-07#resolution_2",
      "action": {
        "query": "values04.rq",
        "data": "data04.ttl"
      },
      "result": "values04.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values5",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with 2 obj-vars, 2 rows with UNDEF",
      "approval": "dawgt:Approved",
      "approvedBy": "http://www.w3.org/2009/sparql/meeting/2012-08-07#resolution_2",
      "action": {
        "query": "values05.rq",
        "data": "data05.ttl"
      },
      "result": "values05.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values6",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with pred-var, 1 row",
      "approval": "dawgt:Approved",
      "approvedBy": "http://www.w3.org/2009/sparql/meeting/2012-08-07#resolution_2",
      "action": {
        "query": "values06.rq",
        "data": "data06.ttl"
      },
      "result": "values06.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values7",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with (OPTIONAL) obj-var, 1 row",
      "approval": "dawgt:Approved",
      "approvedBy": [
        "http://www.w3.org/2009/sparql/meeting/2012-08-07#resolution_2",
        "http://www.w3.org/2009/sparql/meeting/2011-05-24#resolution_4"
      ],
      "action": {
        "query": "values07.rq",
        "data": "data07.ttl"
      },
      "result": "values07.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values8",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with subj/obj-vars, 2 rows with UNDEF",
      "approval": "dawgt:Approved",
      "approvedBy": "http://www.w3.org/2009/sparql/meeting/2012-08-07#resolution_2",
      "action": {
        "query": "values08.rq",
        "data": "data08.ttl"
      },
      "result": "values08.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#inline1",
      "@type": "mf:QueryEvaluationTest",
      "name": "Inline VALUES graph pattern",
      "approval": "dawgt:Approved",
      "approvedBy": "http://www.w3.org/2009/sparql/meeting/2012-08-07#resolution_2",
      "action": {
        "query": "inline01.rq",
        "data": "data01.ttl"
      },
      "result": "inline01.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#inline2",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-subquery VALUES",
      "approval": "dawgt:Approved",
      "approvedBy": "http://www.w3.org/2009/sparql/meeting/2012-08-07#resolution_2",
      "action": {
        "query": "inline02.rq",
        "data": "data02.ttl"
      },
      "result": "inline02.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#graph",
      "@type": "mf:QueryEvaluationTest",
      "name": "VALUES inside GRAPH binding the same variable as the graph name",
      "action": {
        "query": "graph.rq",
        "data": "empty.ttl",
        "graphData": [
          "data01.ttl",
          "data02.ttl"
        ]
      },
      "result": "graph.ttl"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#graph-no-var",
      "@type": "mf:QueryEvaluationTest",
      "name": "VALUES inside GRAPH not mentioning the graph name variable",
      "comment": "Each VALUES row is joined with every named graph",
      "action": {
        "query": "graph-no-var.rq",
        "data": "empty.ttl",
        "graphData": [
          "data01.ttl",
          "data02.ttl"
        ]
      },
      "result": "graph-no-var.ttl"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#graph-from-named-1",
      "@type": "mf:QueryEvaluationTest",
      "name": "VALUES inside GRAPH binding the graph name variable, with FROM NAMED",
      "comment": "Only graphs named by FROM NAMED are iterated; rows binding the graph variable to a graph excluded by FROM NAMED (ex:g2) or to an IRI that is no graph name at all (ex:unknown) are removed",
      "action": {
        "query": "graph-from-named-1.rq",
        "data": "graph-from-named.trig"
      },
      "result": "graph-from-named-1.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#graph-from-named-2",
      "@type": "mf:QueryEvaluationTest",
      "name": "Graph name variable bound outside GRAPH to graphs outside the dataset, with FROM NAMED",
      "comment": "GRAPH ?g does not produce solutions for graph names outside the dataset, even if they are bound by a joined pattern and the inner pattern contains no triple patterns",
      "action": {
        "query": "graph-from-named-2.rq",
        "data": "graph-from-named.trig"
      },
      "result": "graph-from-named-2.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#graph-from-named-3",
      "@type": "mf:QueryEvaluationTest",
      "name": "GRAPH with a fixed IRI outside the dataset around VALUES, with FROM NAMED",
      "comment": "GRAPH <iri> evaluates to the empty multiset if <iri> is not a graph name of the dataset, even if the inner pattern contains no triple patterns",
      "action": {
        "query": "graph-from-named-3.rq",
        "data": "graph-from-named.trig"
      },
      "result": "graph-from-named-3.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-order-by",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with ORDER BY",
      "comment": "ORDER BY sorts by a variable that only the trailing VALUES clause binds",
      "action": {
        "query": "values-order-by.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-order-by.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-offset-limit",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with OFFSET and LIMIT",
      "comment": "OFFSET and LIMIT apply after the join with the trailing VALUES clause",
      "action": {
        "query": "values-offset-limit.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-offset-limit.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-distinct",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with DISTINCT",
      "comment": "DISTINCT applies after the join with the trailing VALUES clause, which duplicates each solution",
      "action": {
        "query": "values-distinct.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-distinct.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-group-order-by",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with GROUP BY and ORDER BY",
      "comment": "The trailing VALUES clause is joined after grouping, so ORDER BY can use an expression over a variable that only the trailing VALUES clause binds",
      "action": {
        "query": "values-group-order-by.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-group-order-by.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-select-star",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with SELECT *",
      "comment": "SELECT * includes the variables of the trailing VALUES clause",
      "action": {
        "query": "values-select-star.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-select-star.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-no-vars-no-rows",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES without variables and without rows",
      "comment": "A trailing VALUES clause without rows makes the result empty",
      "action": {
        "query": "values-no-vars-no-rows.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-no-vars-no-rows.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-no-vars-two-rows",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES without variables and with two rows",
      "comment": "A trailing VALUES clause with two empty rows duplicates each solution",
      "action": {
        "query": "values-no-vars-two-rows.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-no-vars-two-rows.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-subquery-offset-limit",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-subquery VALUES with OFFSET and LIMIT",
      "comment": "OFFSET and LIMIT of the subquery apply after the join with its trailing VALUES clause",
      "action": {
        "query": "values-subquery-offset-limit.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-subquery-offset-limit.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-ask",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with ASK",
      "comment": "The trailing VALUES clause removes all solutions, so the answer is false",
      "action": {
        "query": "values-ask.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-ask.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-construct",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with CONSTRUCT",
      "comment": "The template uses a variable that only the trailing VALUES clause binds",
      "action": {
        "query": "values-construct.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-construct.ttl"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-construct-group-by",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with CONSTRUCT and GROUP BY",
      "comment": "The trailing VALUES clause is joined after grouping, so the template can use a variable that only the trailing VALUES clause binds",
      "action": {
        "query": "values-construct-group-by.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-construct-group-by.ttl"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-construct-limit",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with CONSTRUCT and LIMIT",
      "comment": "The trailing VALUES clause is joined before LIMIT. The template has a single triple, so LIMIT gives the same result whether it applies to the solutions or to the constructed triples",
      "action": {
        "query": "values-construct-limit.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-construct-limit.ttl"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-group-by-projection",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with GROUP BY and projected VALUES variable",
      "comment": "The trailing VALUES clause is joined after grouping, so the projection can use a variable that only the trailing VALUES clause binds",
      "action": {
        "query": "values-group-by-projection.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-group-by-projection.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-group-by-select-expression",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with GROUP BY and VALUES variable in SELECT expression",
      "comment": "The trailing VALUES clause is joined after grouping, so a SELECT expression can use a variable that only the trailing VALUES clause binds",
      "action": {
        "query": "values-group-by-select-expression.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-group-by-select-expression.srx"
    },
    {
      "@id": "http://www.w3.org/2009/sparql/docs/tests/data-sparql11/bindings/manifest#values-group-by-join",
      "@type": "mf:QueryEvaluationTest",
      "name": "Post-query VALUES with GROUP BY joined on the grouping variable",
      "comment": "The trailing VALUES clause is joined with the grouped solutions on the grouping variable",
      "action": {
        "query": "values-group-by-join.rq",
        "data": "data-modifiers.ttl"
      },
      "result": "values-group-by-join.srx"
    }
  ]
}